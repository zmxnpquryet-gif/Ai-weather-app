<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1: Translucent Frosted Glass Base Backdrop -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="315"
                android:startColor="@color/widget_bg_start"
                android:centerColor="@color/widget_bg_mid"
                android:endColor="@color/widget_bg_end"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 2: Top-Left Diagonal Glass Specular Refraction Sheen + Luminous Rim Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/widget_specular_sheen"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="@color/widget_border_stroke" />
        </shape>
    </item>
</layer-list>
